#!/bin/sh
# Generated by farrier from the `hooks:` front matter of the installed skills and policies.
# Do not edit — `farrier install` rewrites it. Add or remove a hook by changing
# the skill or policy that declares it, or by changing what `agents.yml` selects.
set -eu

root=$(git rev-parse --show-toplevel)

if [ -z "${STABLEMATE_CACHE_DIR:-}" ]; then
  case $(uname -s) in
    Darwin) STABLEMATE_CACHE_DIR="$HOME/Library/Caches/stablemate" ;;
    MINGW*|MSYS*|CYGWIN*) STABLEMATE_CACHE_DIR="${LOCALAPPDATA:-}/stablemate/stablemate/Cache" ;;
    *) STABLEMATE_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/stablemate" ;;
  esac
fi
export STABLEMATE_CACHE_DIR

# commit-and-push
for gate in "$root/.agents/policies/commit-and-push/scripts/check_commit_message.py"; do
  [ -f "$gate" ] || continue
  python3 "$gate" "$@"
  break
done
