    f2__emit -> f2____end [color=darkgreen];
    f2__mark -> f2__pick;
    f2__pick -> f2__assess [label="unit_id, unit_path, unit_kind, record_path, progress"];
    f2__pick -> f2__verify;
    f2__start -> f2__pick;
    f2__verify -> f2__emit;
    f2____end -> f0__start [style=dashed, color=gray40];
