      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f3__next_affected_story__0 [label="select_affected_story\nResolve the next approved affected story without widening the edit worklist.", shape=box, fillcolor=white];
    }
