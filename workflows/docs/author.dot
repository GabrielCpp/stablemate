digraph author {
  rankdir=TB;
  bgcolor=white;
  node [shape=box, style="rounded,filled", fillcolor=lightblue];
  edge [color=darkblue, fontsize=10];

  subgraph cluster_default_f0__ {
    label="default";
    style=dashed; color=gray50; fontsize=11;

    f0____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    f0__next_stage [label="next_stage\ncall plan_author_step"];
    f0__start [label="start\ncall adopt_backlog, seed_story, prune_bullet"];
    f0____end [label="END", shape=doublecircle, fillcolor=lightgreen, width=0.4];

    f0____start -> f0__start;
    f0__next_stage -> f0__next_stage [label="blocked"];
    f0__next_stage -> f0____end [color=darkgreen];
    f0__next_stage -> f5____start [label="handoff", style=dashed, color=gray40];
    f0__next_stage -> f6____start [label="handoff", style=dashed, color=gray40];
    f0__next_stage -> f7____start [label="handoff", style=dashed, color=gray40];
    f0__next_stage -> f8____start [label="handoff", style=dashed, color=gray40];
    f0__next_stage -> f9____start [label="handoff", style=dashed, color=gray40];
    f0__next_stage -> f10____start [label="handoff", style=dashed, color=gray40];
    f0__start -> f0__next_stage;
    f0__start -> f0____end [color=darkgreen];
    f0__start -> f9____start [label="handoff", style=dashed, color=gray40];
    f0__start -> f1____start [label="handoff", style=dashed, color=gray40];
    f0__start -> f2____start [label="handoff", style=dashed, color=gray40];
  }

  subgraph cluster_surveyor_f1__ {
    label="surveyor";
    style=dashed; color=gray50; fontsize=11;

    f1____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    f1__assess [label="assess\nagent assess-unit.md"];
    f1__check [label="check\ncall validate_record, mark_unit"];
    f1__emit [label="emit\ncall emit_artifacts"];
    f1__expand [label="expand\ncall expand_inventory"];
    f1__fix [label="fix\nagent fix-record.md"];
    f1__partition [label="partition\ncall validate_partition\nagent partition-findings.md"];
    f1__pick [label="pick\ncall select_next_unit"];
    f1__plan [label="plan\nagent plan-units.md"];
    f1__resolve_partition [label="resolve_partition\nagent resolve-operator.md"];
    f1__resolve_plan [label="resolve_plan\nagent resolve-operator.md"];
    f1__resolve_verify [label="resolve_verify\nagent resolve-operator.md"];
    f1__split [label="split\ncall split_unit, mark_unit"];
    f1__start [label="start\ncall check_inventory"];
    f1__verify [label="verify\ncall verify_records"];
    f1____end [label="END → back to start", shape=doublecircle, fillcolor=lightgreen, width=0.4];

    f1____start -> f1__start;
    f1__assess -> f1__check [label="unit_id, record_path, verify_resolve"];
    f1__assess -> f1__split [label="unit_id, record_path, verify_resolve"];
    f1__check -> f1__fix [label="unit_id, record_path, record_errors, record_fix, verify_resolve"];
    f1__check -> f1__pick [label="verify_resolve"];
    f1__emit -> f1____end [color=darkgreen];
    f1__expand -> f1__plan [label="plan_rework, plan_errors, plan_resolve"];
    f1__expand -> f1__pick;
    f1__expand -> f1__resolve_plan [label="notes, plan_resolve"];
    f1__expand -> f1__plan [label="plan_rework, plan_resolve", style=dashed, color=darkorange];
    f1__fix -> f1__check [label="unit_id, record_path, record_fix, verify_resolve"];
    f1__partition -> f1__partition [label="partition_rework, partition_errors, partition_resolve"];
    f1__partition -> f1__resolve_partition [label="notes, partition_resolve"];
    f1__partition -> f1__partition [label="partition_rework, partition_resolve", style=dashed, color=darkorange];
    f1__partition -> f1__emit;
    f1__pick -> f1__assess [label="unit_id, unit_path, unit_kind, record_path, progress, verify_resolve"];
    f1__pick -> f1__verify [label="verify_resolve"];
    f1__plan -> f1__expand [label="plan_rework, plan_resolve"];
    f1__plan -> f1__resolve_plan [label="notes, plan_resolve"];
    f1__plan -> f1__plan [label="plan_rework, plan_resolve", style=dashed, color=darkorange];
    f1__resolve_partition -> f1__partition [label="partition_rework, partition_resolve", style=dashed, color=darkorange];
    f1__resolve_plan -> f1__plan [label="plan_rework, plan_resolve", style=dashed, color=darkorange];
    f1__resolve_verify -> f1__pick [label="verify_resolve", style=dashed, color=darkorange];
    f1__split -> f1__pick [label="verify_resolve"];
    f1__start -> f1__expand;
    f1__start -> f1__plan;
    f1__verify -> f1__resolve_verify [label="notes, verify_resolve"];
    f1__verify -> f1__partition;
    f1__verify -> f1__pick [label="verify_resolve", style=dashed, color=darkorange];
    f1____end -> f0__start [style=dashed, color=gray40];
  }

