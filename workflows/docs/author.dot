      node [style="filled", fontsize=10];
      f10__close__0 [label="validate_artifacts\nCan the coder engine actually walk what this run produced?", shape=box, fillcolor=white];
      f10__close__1 [label="validate_roadmap_milestone\nProve the roadmap owns exactly one non-empty milestone.", shape=box, fillcolor=white];
      f10__close__2 [label="mark_roadmap_authored\nAdvance one validated roadmap from approved to authored, idempotently.", shape=box, fillcolor=white];
      f10__close__3 [label="commit_author\nCommit the epic/story docs this run wrote, in the one repo it wrote them in.", shape=box, fillcolor=white];
      f10__close__0 -> f10__close__1 [color=gray40, arrowsize=0.6];
      f10__close__1 -> f10__close__2 [color=gray40, arrowsize=0.6];
      f10__close__2 -> f10__close__3 [color=gray40, arrowsize=0.6];
    }
    subgraph cluster_f10__integrity {
      label="integrity"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f10__integrity__0 [label="verify_integrity\n`ostler doctor` over the whole graph, as a blocking gate.", shape=box, fillcolor=white];
    }
    subgraph cluster_f10__reconcile {
      label="reconcile"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f10__reconcile__0 [label="verify_reconcile\nScope this run silently dropped, measured against the last committed epics.", shape=box, fillcolor=white];
    }
    subgraph cluster_f10__resolve_graph {
      label="resolve_graph"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f10__resolve_graph__0 [label="resolve-integrity.md\nResolve a referential-integrity block autonomously (author)", shape=note, fillcolor=lightyellow];
    }
    subgraph cluster_f10__resolve_milestone {
      label="resolve_milestone"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f10__resolve_milestone__0 [label="resolve-integrity.md\nResolve a referential-integrity block autonomously (author)", shape=note, fillcolor=lightyellow];
    }
    subgraph cluster_f10__resolve_reconcile {
      label="resolve_reconcile"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f10__resolve_reconcile__0 [label="resolve-operator.md\nDiagnose an operator block (author)", shape=note, fillcolor=lightyellow];
    }
    subgraph cluster_f10__roadmap_milestone {
      label="roadmap_milestone"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f10__roadmap_milestone__0 [label="validate_roadmap_milestone\nProve the roadmap owns exactly one non-empty milestone.", shape=box, fillcolor=white];
    }
    f10__start [label="start"];
    f10____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f10____start -> f10__start;
    f10__close__3 -> f10____end [color=darkgoldenrod, ltail=cluster_f10__close];
    f10__integrity__0 -> f10__resolve_graph__0 [label="notes, resolves", ltail=cluster_f10__integrity, lhead=cluster_f10__resolve_graph];
    f10__integrity__0 -> f10__roadmap_milestone__0 [ltail=cluster_f10__integrity, lhead=cluster_f10__roadmap_milestone];
    f10__integrity__0 -> f10__roadmap_milestone__0 [style=dashed, color=darkorange, ltail=cluster_f10__integrity, lhead=cluster_f10__roadmap_milestone];
    f10__reconcile__0 -> f10__resolve_reconcile__0 [label="notes, resolves", ltail=cluster_f10__reconcile, lhead=cluster_f10__resolve_reconcile];
    f10__reconcile__0 -> f10__integrity__0 [ltail=cluster_f10__reconcile, lhead=cluster_f10__integrity];
    f10__reconcile__0 -> f10__integrity__0 [style=dashed, color=darkorange, ltail=cluster_f10__reconcile, lhead=cluster_f10__integrity];
    f10__resolve_graph__0 -> f10__integrity__0 [label="resolves", ltail=cluster_f10__resolve_graph, lhead=cluster_f10__integrity];
    f10__resolve_graph__0 -> f10__roadmap_milestone__0 [style=dashed, color=darkorange, ltail=cluster_f10__resolve_graph, lhead=cluster_f10__roadmap_milestone];
    f10__resolve_milestone__0 -> f10__roadmap_milestone__0 [label="resolves", ltail=cluster_f10__resolve_milestone, lhead=cluster_f10__roadmap_milestone];
    f10__resolve_milestone__0 -> f10__close__0 [style=dashed, color=darkorange, ltail=cluster_f10__resolve_milestone, lhead=cluster_f10__close];
    f10__resolve_reconcile__0 -> f10__integrity__0 [style=dashed, color=darkorange, ltail=cluster_f10__resolve_reconcile, lhead=cluster_f10__integrity];
    f10__roadmap_milestone__0 -> f10__resolve_milestone__0 [label="notes, resolves", ltail=cluster_f10__roadmap_milestone, lhead=cluster_f10__resolve_milestone];
    f10__roadmap_milestone__0 -> f10__close__0 [ltail=cluster_f10__roadmap_milestone, lhead=cluster_f10__close];
    f10__roadmap_milestone__0 -> f10__close__0 [style=dashed, color=darkorange, ltail=cluster_f10__roadmap_milestone, lhead=cluster_f10__close];
    f10__start -> f10__reconcile__0 [lhead=cluster_f10__reconcile];
  }

  subgraph cluster_legend {
    label="legend";
    style=dashed; color=gray50; fontsize=11;
    node [shape=plaintext, style="", fillcolor=white, fontsize=10];
    legend_a [label=""]; legend_b [label=""];
    legend_c [label=""]; legend_d [label=""];
    legend_e [label=""]; legend_f [label=""];
    legend_a -> legend_b [label="continue"];
    legend_c -> legend_d [label="await: parked on an operator gate", style=dashed, color=darkorange];
    legend_e -> legend_f [label="done: the flow ends", color=darkgoldenrod];
    subgraph cluster_legend_state {
      label="a state: what it runs, top to bottom";
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled"];
      legend_call [label="a node call\nits docstring", shape=box, fillcolor=white];
      legend_agent [label="an agent turn: prompt.md\nits title", shape=note, fillcolor=lightyellow];
      legend_handoff [label="handoff → a sub-flow\nrun to its END, then back here", shape=box, fillcolor=plum];
      legend_call -> legend_agent -> legend_handoff [color=gray40, arrowsize=0.6];
    }
  }
}
