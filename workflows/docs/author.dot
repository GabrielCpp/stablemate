    f2__review_story__0 -> f2__rework_story__0 [tooltip="intent, applied, pick, index, mockup, findings, reworks", ltail=cluster_f2__review_story, lhead=cluster_f2__rework_story];
    f2__review_story__0 -> f2__write_story__0 [tooltip="intent, applied, pick, index, mockup, reworks", style=dashed, color=darkorange, ltail=cluster_f2__review_story, lhead=cluster_f2__write_story];
    f2__rework_story__1 -> f2__check_story__0 [tooltip="intent, applied, pick, index, mockup, reworks, prior", ltail=cluster_f2__rework_story, lhead=cluster_f2__check_story];
    f2__rewrite_epic__2 -> f2__rewrite_epic__0 [tooltip="intent, snapshot, plan, applied, findings, reworks", style=dashed, color=darkorange];
    f2__rewrite_epic__2 -> f2__next_affected_story__0 [tooltip="intent, applied, index", ltail=cluster_f2__rewrite_epic, lhead=cluster_f2__next_affected_story];
    f2__start__0 -> f2__plan_edit__0 [tooltip="intent, snapshot", ltail=cluster_f2__start, lhead=cluster_f2__plan_edit];
    f2__validate_plan__0 -> f2__refine_plan__0 [tooltip="intent, snapshot, plan, findings, reworks", ltail=cluster_f2__validate_plan, lhead=cluster_f2__refine_plan];
    f2__validate_plan__0 -> f2__review_plan__0 [tooltip="intent, snapshot, plan, reworks", ltail=cluster_f2__validate_plan, lhead=cluster_f2__review_plan];
    f2__validate_plan__0 -> f2__plan_edit__0 [tooltip="intent, snapshot", style=dashed, color=darkorange, ltail=cluster_f2__validate_plan, lhead=cluster_f2__plan_edit];
    f2__write_story__0 -> f2__check_story__0 [tooltip="intent, applied, pick, index, mockup, reworks", ltail=cluster_f2__write_story, lhead=cluster_f2__check_story];
    f2__write_story__0 -> f2__write_story__0 [tooltip="intent, applied, pick, index, mockup, reworks", style=dashed, color=darkorange];
