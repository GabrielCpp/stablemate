digraph author {
  rankdir=TB;
  bgcolor=white;
  compound=true;
  newrank=true;
  node [shape=box, style="rounded,filled", fillcolor=lightblue];
  edge [color=darkblue, fontsize=10];

  subgraph cluster_default_f0__ {
    label="default";
    style=dashed; color=gray50; fontsize=11;

    f0____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f0__next_stage {
      label="next_stage"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__next_stage__0 [label="plan_author_step\nSelect exactly one next stage from the approved roadmap's current artifacts.", shape=box, fillcolor=white];
      f0__next_stage__1 [label="handoff → milestone", shape=box, fillcolor=plum];
      f0__next_stage__2 [label="handoff → epic-split", shape=box, fillcolor=plum];
      f0__next_stage__3 [label="handoff → epic-author", shape=box, fillcolor=plum];
      f0__next_stage__4 [label="handoff → story-split", shape=box, fillcolor=plum];
      f0__next_stage__5 [label="handoff → story-author", shape=box, fillcolor=plum];
      f0__next_stage__6 [label="handoff → finalize", shape=box, fillcolor=plum];
      f0__next_stage__0 -> f0__next_stage__1 [color=gray40, arrowsize=0.6];
      f0__next_stage__1 -> f0__next_stage__2 [color=gray40, arrowsize=0.6];
      f0__next_stage__2 -> f0__next_stage__3 [color=gray40, arrowsize=0.6];
      f0__next_stage__3 -> f0__next_stage__4 [color=gray40, arrowsize=0.6];
      f0__next_stage__4 -> f0__next_stage__5 [color=gray40, arrowsize=0.6];
      f0__next_stage__5 -> f0__next_stage__6 [color=gray40, arrowsize=0.6];
    }
    subgraph cluster_f0__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__start__0 [label="adopt_backlog\nMint ids for every unnamed backlog bullet before decomposition or story lookup.", shape=box, fillcolor=white];
      f0__start__1 [label="seed_story\nRegister ONE bullet as a new story inside an already-existing epic.", shape=box, fillcolor=white];
      f0__start__2 [label="handoff → story-author", shape=box, fillcolor=plum];
      f0__start__3 [label="handoff → surveyor", shape=box, fillcolor=plum];
      f0__start__4 [label="handoff → parity-surveyor", shape=box, fillcolor=plum];
      f0__start__5 [label="prune_bullet\nRemove the one backlog bullet story mode consumed — story mode's tail.", shape=box, fillcolor=white];
      f0__start__0 -> f0__start__1 [color=gray40, arrowsize=0.6];
      f0__start__1 -> f0__start__2 [color=gray40, arrowsize=0.6];
      f0__start__2 -> f0__start__3 [color=gray40, arrowsize=0.6];
      f0__start__3 -> f0__start__4 [color=gray40, arrowsize=0.6];
      f0__start__4 -> f0__start__5 [color=gray40, arrowsize=0.6];
    }
    f0____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f0____start -> f0__start__0 [lhead=cluster_f0__start];
    f0__next_stage__6 -> f0__next_stage__0 [label="blocked"];
    f0__next_stage__6 -> f0____end [color=darkgoldenrod, ltail=cluster_f0__next_stage];
    f0__start__5 -> f0__next_stage__0 [ltail=cluster_f0__start, lhead=cluster_f0__next_stage];
    f0__start__5 -> f0____end [color=darkgoldenrod, ltail=cluster_f0__start];
  }

  subgraph cluster_surveyor_f1__ {
    label="surveyor";
    style=dashed; color=gray50; fontsize=11;

    f1____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f1__assess {
      label="assess"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__assess__0 [label="assess-unit.md\nAssess one unit against the rubric", shape=note, fillcolor=lightyellow];
    }
    subgraph cluster_f1__check {
      label="check"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__check__0 [label="validate_record\nCheck one unit's finding record, hard and deterministically.", shape=box, fillcolor=white];
      f1__check__1 [label="mark_unit\nStamp the unit's inventory entry with its (validated) record's status.", shape=box, fillcolor=white];
      f1__check__0 -> f1__check__1 [color=gray40, arrowsize=0.6];
    }
    subgraph cluster_f1__emit {
      label="emit"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__emit__0 [label="emit_artifacts\nWrite the generated backlog bullets and the unit-level manifest.", shape=box, fillcolor=white];
    }
    subgraph cluster_f1__expand {
      label="expand"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__expand__0 [label="expand_inventory\nMaterialize the unit inventory from the enumeration rules — then freeze it.", shape=box, fillcolor=white];
    }
    subgraph cluster_f1__fix {
      label="fix"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__fix__0 [label="fix-record.md\nRepair a finding record so it validates", shape=note, fillcolor=lightyellow];
    }
    subgraph cluster_f1__partition {
      label="partition"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__partition__0 [label="partition-findings.md\nPartition the finding records into epic/story candidates", shape=note, fillcolor=lightyellow];
      f1__partition__1 [label="validate_partition\nEvery non-clean unit maps into at least one cluster, and no cluster invents units.", shape=box, fillcolor=white];
      f1__partition__0 -> f1__partition__1 [color=gray40, arrowsize=0.6];
    }
    subgraph cluster_f1__pick {
      label="pick"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__pick__0 [label="select_next_unit\nThe first unit still `pending`, or the news that none is left.", shape=box, fillcolor=white];
    }
    subgraph cluster_f1__plan {
      label="plan"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__plan__0 [label="plan-units.md\nenumeration rules for the survey", shape=note, fillcolor=lightyellow];
    }
    subgraph cluster_f1__resolve_partition {
      label="resolve_partition"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__resolve_partition__0 [label="resolve-operator.md\nDiagnose an operator block (surveyor)", shape=note, fillcolor=lightyellow];
    }
    subgraph cluster_f1__resolve_plan {
      label="resolve_plan"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__resolve_plan__0 [label="resolve-operator.md\nDiagnose an operator block (surveyor)", shape=note, fillcolor=lightyellow];
    }
    subgraph cluster_f1__resolve_verify {
      label="resolve_verify"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__resolve_verify__0 [label="resolve-operator.md\nDiagnose an operator block (surveyor)", shape=note, fillcolor=lightyellow];
    }
    subgraph cluster_f1__split {
      label="split"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__split__0 [label="split_unit\nReplace a too-big folder unit with its immediate children.", shape=box, fillcolor=white];
      f1__split__1 [label="mark_unit\nStamp the unit's inventory entry with its (validated) record's status.", shape=box, fillcolor=white];
      f1__split__0 -> f1__split__1 [color=gray40, arrowsize=0.6];
    }
    subgraph cluster_f1__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__start__0 [label="check_inventory\nDecide whether the granularity planner needs its one bounded judgment.", shape=box, fillcolor=white];
    }
    subgraph cluster_f1__verify {
      label="verify"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__verify__0 [label="verify_records\nThe coverage gate: every frozen unit accounted for, and no silent shrinkage.", shape=box, fillcolor=white];
    }
    f1____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f1____start -> f1__start__0 [lhead=cluster_f1__start];
    f1__assess__0 -> f1__check__0 [label="unit_id, record_path, verify_resolve", ltail=cluster_f1__assess, lhead=cluster_f1__check];
    f1__assess__0 -> f1__split__0 [label="unit_id, record_path, verify_resolve", ltail=cluster_f1__assess, lhead=cluster_f1__split];
    f1__check__1 -> f1__fix__0 [label="unit_id, record_path, record_errors, record_fix, verify_resolve", ltail=cluster_f1__check, lhead=cluster_f1__fix];
    f1__check__1 -> f1__pick__0 [label="verify_resolve", ltail=cluster_f1__check, lhead=cluster_f1__pick];
    f1__emit__0 -> f1____end [color=darkgoldenrod, ltail=cluster_f1__emit];
    f1__expand__0 -> f1__plan__0 [label="plan_rework, plan_errors, plan_resolve", ltail=cluster_f1__expand, lhead=cluster_f1__plan];
    f1__expand__0 -> f1__pick__0 [ltail=cluster_f1__expand, lhead=cluster_f1__pick];
    f1__expand__0 -> f1__resolve_plan__0 [label="notes, plan_resolve", ltail=cluster_f1__expand, lhead=cluster_f1__resolve_plan];
    f1__expand__0 -> f1__plan__0 [label="plan_rework, plan_resolve", style=dashed, color=darkorange, ltail=cluster_f1__expand, lhead=cluster_f1__plan];
    f1__fix__0 -> f1__check__0 [label="unit_id, record_path, record_fix, verify_resolve", ltail=cluster_f1__fix, lhead=cluster_f1__check];
    f1__partition__1 -> f1__partition__0 [label="partition_rework, partition_errors, partition_resolve"];
    f1__partition__1 -> f1__resolve_partition__0 [label="notes, partition_resolve", ltail=cluster_f1__partition, lhead=cluster_f1__resolve_partition];
    f1__partition__1 -> f1__partition__0 [label="partition_rework, partition_resolve", style=dashed, color=darkorange];
    f1__partition__1 -> f1__emit__0 [ltail=cluster_f1__partition, lhead=cluster_f1__emit];
    f1__pick__0 -> f1__assess__0 [label="unit_id, unit_path, unit_kind, record_path, progress, verify_resolve", ltail=cluster_f1__pick, lhead=cluster_f1__assess];
    f1__pick__0 -> f1__verify__0 [label="verify_resolve", ltail=cluster_f1__pick, lhead=cluster_f1__verify];
    f1__plan__0 -> f1__expand__0 [label="plan_rework, plan_resolve", ltail=cluster_f1__plan, lhead=cluster_f1__expand];
    f1__plan__0 -> f1__resolve_plan__0 [label="notes, plan_resolve", ltail=cluster_f1__plan, lhead=cluster_f1__resolve_plan];
    f1__plan__0 -> f1__plan__0 [label="plan_rework, plan_resolve", style=dashed, color=darkorange];
    f1__resolve_partition__0 -> f1__partition__0 [label="partition_rework, partition_resolve", style=dashed, color=darkorange, ltail=cluster_f1__resolve_partition, lhead=cluster_f1__partition];
    f1__resolve_plan__0 -> f1__plan__0 [label="plan_rework, plan_resolve", style=dashed, color=darkorange, ltail=cluster_f1__resolve_plan, lhead=cluster_f1__plan];
    f1__resolve_verify__0 -> f1__pick__0 [label="verify_resolve", style=dashed, color=darkorange, ltail=cluster_f1__resolve_verify, lhead=cluster_f1__pick];
    f1__split__1 -> f1__pick__0 [label="verify_resolve", ltail=cluster_f1__split, lhead=cluster_f1__pick];
    f1__start__0 -> f1__expand__0 [ltail=cluster_f1__start, lhead=cluster_f1__expand];
    f1__start__0 -> f1__plan__0 [ltail=cluster_f1__start, lhead=cluster_f1__plan];
    f1__verify__0 -> f1__resolve_verify__0 [label="notes, verify_resolve", ltail=cluster_f1__verify, lhead=cluster_f1__resolve_verify];
    f1__verify__0 -> f1__partition__0 [ltail=cluster_f1__verify, lhead=cluster_f1__partition];
    f1__verify__0 -> f1__pick__0 [label="verify_resolve", style=dashed, color=darkorange, ltail=cluster_f1__verify, lhead=cluster_f1__pick];
  }

