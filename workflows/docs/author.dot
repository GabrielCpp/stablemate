digraph author {
  rankdir=TB;
  bgcolor=white;
  compound=true;
  newrank=true;
  node [shape=box, style="rounded,filled", fillcolor=lightblue];
  edge [color=darkblue, fontsize=10];

  subgraph cluster_default_f0__ {
    label="default";
    style=dashed; color=gray50; fontsize=11;

    f0____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    f0__answered_split [label="answered_split"];
    subgraph cluster_f0__author_row {
      label="author_row"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__author_row__0 [label="handoff → story-author", shape=box, fillcolor=plum];
      f0__author_row__1 [label="handoff → epic-author", shape=box, fillcolor=plum];
      f0__author_row__2 [label="handoff → story-split", shape=box, fillcolor=plum];
      f0__author_row__0 -> f0__author_row__1 [style=invis];
      f0__author_row__1 -> f0__author_row__2 [style=invis];
    }
    subgraph cluster_f0__complete {
      label="complete"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__complete__0 [label="check_completion\nWhether the milestone body still matches *baseline*, and every work-list row not yet done.", shape=box, fillcolor=white];
      f0__complete__1 [label="handoff → finalize", shape=box, fillcolor=plum];
      f0__complete__0 -> f0__complete__1 [style=invis];
    }
    f0__drain [label="drain"];
    subgraph cluster_f0__fill {
      label="fill"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__fill__0 [label="fill_work\nFile every item of *kind* the planning graph holds, satisfied ones as done, skipping ids already filed.", shape=box, fillcolor=white];
    }
    f0__requeue [label="requeue"];
    subgraph cluster_f0__split_epics {
      label="split_epics"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__split_epics__0 [label="handoff → epic-split", shape=box, fillcolor=plum];
      f0__split_epics__1 [label="check_epic_split\nWhether the approved milestone already has a valid ordered epic split.", shape=box, fillcolor=white];
      f0__split_epics__0 -> f0__split_epics__1 [style=invis];
    }
    subgraph cluster_f0__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__start__0 [label="contract_digest\nThe sha256 of the milestone body, which the run never writes, so a change is an operator's edit.", shape=box, fillcolor=white];
      f0__start__1 [label="snapshot_epics\nEach epic's seed ids and story slugs as the run found them, for the reconcile gate to measure drops against.", shape=box, fillcolor=white];
      f0__start__2 [label="seed_story\nRegister ONE register record as a new story inside an already-existing epic.", shape=box, fillcolor=white];
      f0__start__3 [label="derive_story_services\nA story's services stay inside the sorted union of the services of the seeds it covers.", shape=box, fillcolor=white];
      f0__start__4 [label="handoff → story-author", shape=box, fillcolor=plum];
      f0__start__5 [label="handoff → parity-surveyor", shape=box, fillcolor=plum];
      f0__start__6 [label="promote_record\nClose the record a story was authored from as promoted, naming the story and its epic.", shape=box, fillcolor=white];
      f0__start__0 -> f0__start__1 [style=invis];
      f0__start__1 -> f0__start__2 [style=invis];
      f0__start__2 -> f0__start__3 [style=invis];
      f0__start__3 -> f0__start__4 [style=invis];
      f0__start__4 -> f0__start__5 [style=invis];
      f0__start__5 -> f0__start__6 [style=invis];
    }
    f0____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f0____start -> f0__start__0 [lhead=cluster_f0__start];
    f0__answered_split -> f0__split_epics__0 [label="the operator answered", tooltip="note", lhead=cluster_f0__split_epics];
    f0__author_row__2 -> f0__drain [label="row authored or blocked", tooltip="stage", ltail=cluster_f0__author_row];
    f0__complete__1 -> f0____end [label="every row done", color=darkgoldenrod, ltail=cluster_f0__complete];
    f0__complete__1 -> f0__complete__0 [label="the milestone body changed", tooltip="baseline", style=dashed, color=darkorange];
    f0__complete__1 -> f0__requeue [label="rows left unfinished", tooltip="ids, question", style=dashed, color=darkorange, ltail=cluster_f0__complete];
    f0__drain -> f0__fill__0 [label="stage drained", tooltip="stage", lhead=cluster_f0__fill];
    f0__drain -> f0__complete__0 [label="last stage drained", lhead=cluster_f0__complete];
    f0__drain -> f0__drain [label="another chunk"];
    f0__drain -> f0__author_row__0 [label="drain target", tooltip="items, stage", lhead=cluster_f0__author_row];
    f0__fill__0 -> f0__drain [label="rows queued", tooltip="stage", ltail=cluster_f0__fill];
    f0__requeue -> f0__split_epics__0 [label="rows requeued with the answer", lhead=cluster_f0__split_epics];
    f0__split_epics__1 -> f0__fill__0 [label="the milestone has an ordered split", ltail=cluster_f0__split_epics, lhead=cluster_f0__fill];
    f0__split_epics__1 -> f0__answered_split [label="the split stayed blocked", tooltip="question", style=dashed, color=darkorange, ltail=cluster_f0__split_epics];
    f0__start__6 -> f0__split_epics__0 [label="milestone digested", ltail=cluster_f0__start, lhead=cluster_f0__split_epics];
    f0__start__6 -> f0____end [label="parity survey mode / register story written", color=darkgoldenrod, ltail=cluster_f0__start];
  }

  subgraph cluster_parity_surveyor_f1__ {
    label="parity-surveyor";
    style=dashed; color=gray50; fontsize=11;

    f1____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f1__assess {
      label="assess"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__assess__0 [label="read_parity_register\nThe open records of the surveyed repository, for the assessor to match a surface against.", shape=box, fillcolor=white];
      f1__assess__1 [label="assess-parity-unit.md\nCompare one baseline surface with the current service books", shape=note, fillcolor=lightyellow];
      f1__assess__0 -> f1__assess__1 [style=invis];
    }
    subgraph cluster_f1__emit {
      label="emit"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__emit__0 [label="emit_parity_records\nOne register record per assessed surface that no new-app feature already owns.", shape=box, fillcolor=white];
    }
    subgraph cluster_f1__mark {
      label="mark"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__mark__0 [label="validate_record\nCheck one unit's finding record, hard and deterministically.", shape=box, fillcolor=white];
      f1__mark__1 [label="mark_unit\nStamp the unit's inventory entry with its (validated) record's status.", shape=box, fillcolor=white];
      f1__mark__0 -> f1__mark__1 [style=invis];
    }
    subgraph cluster_f1__pick {
      label="pick"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__pick__0 [label="select_next_unit\nThe first unit still `pending`, or the news that none is left.", shape=box, fillcolor=white];
    }
    subgraph cluster_f1__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__start__0 [label="expand_parity_inventory\nFreeze one survey unit per baseline surface.", shape=box, fillcolor=white];
    }
    subgraph cluster_f1__verify {
      label="verify"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__verify__0 [label="verify_records\nThe coverage gate: every frozen unit accounted for, and no silent shrinkage.", shape=box, fillcolor=white];
    }
    f1____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f1____start -> f1__start__0 [lhead=cluster_f1__start];
    f1__assess__1 -> f1__mark__0 [label="assessed", tooltip="unit_id, record_path", ltail=cluster_f1__assess, lhead=cluster_f1__mark];
    f1__emit__0 -> f1____end [label="records emitted", color=darkgoldenrod, ltail=cluster_f1__emit];
    f1__mark__1 -> f1__pick__0 [label="unit marked", ltail=cluster_f1__mark, lhead=cluster_f1__pick];
    f1__pick__0 -> f1__assess__0 [label="a unit pending", tooltip="unit_id, unit_path, unit_kind, record_path, progress", ltail=cluster_f1__pick, lhead=cluster_f1__assess];
    f1__pick__0 -> f1__verify__0 [label="no unit pending", ltail=cluster_f1__pick, lhead=cluster_f1__verify];
    f1__start__0 -> f1__pick__0 [label="inventory frozen", ltail=cluster_f1__start, lhead=cluster_f1__pick];
    f1__verify__0 -> f1__emit__0 [label="coverage holds", ltail=cluster_f1__verify, lhead=cluster_f1__emit];
  }

  subgraph cluster_epic_edit_f2__ {
    label="epic-edit";
    style=dashed; color=gray50; fontsize=11;

    f2____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f2__apply_plan {
      label="apply_plan"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__apply_plan__0 [label="apply_edit_plan\nApply one validated plan idempotently through Ostler's structural APIs.", shape=box, fillcolor=white];
      f2__apply_plan__1 [label="validate_applied_edit\nProve disk matches the approved graph and unaffected story bodies remain byte-stable.", shape=box, fillcolor=white];
      f2__apply_plan__0 -> f2__apply_plan__1 [style=invis];
    }
    subgraph cluster_f2__check_coverage {
      label="check_coverage"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__check_coverage__0 [label="validate_coverage\nEvery seed covered by a story, the story graph acyclic, every story file present.", shape=box, fillcolor=white];
      f2__check_coverage__1 [label="handoff → pm-review", shape=box, fillcolor=plum];
      f2__check_coverage__0 -> f2__check_coverage__1 [style=invis];
    }
    subgraph cluster_f2__design_mockup {
      label="design_mockup"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__design_mockup__0 [label="design-mockup.md\nDesign a mockup for a new screen: `{{ workhorse_var('story_slug') }}`", shape=note, fillcolor=lightyellow];
      f2__design_mockup__1 [label="check_mockup_needed\nA story needs a mockup exactly when one of its services is a UI book.", shape=box, fillcolor=white];
      f2__design_mockup__0 -> f2__design_mockup__1 [style=invis];
    }
    subgraph cluster_f2__draft_story {
      label="draft_story"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__draft_story__0 [label="handoff → draft", shape=box, fillcolor=plum];
    }
    subgraph cluster_f2__finish {
      label="finish"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__finish__0 [label="verify_integrity\n`ostler doctor` over the whole graph, as a blocking gate.", shape=box, fillcolor=white];
      f2__finish__1 [label="commit_author\nCommit the epic/story docs this run wrote, in the one repo it wrote them in.", shape=box, fillcolor=white];
      f2__finish__2 [label="promote_record\nClose the record a story was authored from as promoted, naming the story and its epic.", shape=box, fillcolor=white];
      f2__finish__0 -> f2__finish__1 [style=invis];
      f2__finish__1 -> f2__finish__2 [style=invis];
    }
    subgraph cluster_f2__next_affected_story {
      label="next_affected_story"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__next_affected_story__0 [label="select_affected_story\nResolve the next approved affected story without widening the edit worklist.", shape=box, fillcolor=white];
      f2__next_affected_story__1 [label="derive_story_services\nA story's services stay inside the sorted union of the services of the seeds it covers.", shape=box, fillcolor=white];
      f2__next_affected_story__0 -> f2__next_affected_story__1 [style=invis];
    }
    subgraph cluster_f2__plan_edit {
      label="plan_edit"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__plan_edit__0 [label="plan-epic-edit.md\nPlan an edit to epic `{{ workhorse_var('snapshot').epic }}`", shape=note, fillcolor=lightyellow];
      f2__plan_edit__1 [label="read_register_listing\nThe open records of every repository, one line each under a header, for the planner to read.", shape=box, fillcolor=white];
      f2__plan_edit__0 -> f2__plan_edit__1 [style=invis];
    }
    subgraph cluster_f2__refine_plan {
      label="refine_plan"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__refine_plan__0 [label="refine-epic-edit-plan.md\nRefine an invalid epic edit plan", shape=note, fillcolor=lightyellow];
      f2__refine_plan__1 [label="read_register_listing\nThe open records of every repository, one line each under a header, for the planner to read.", shape=box, fillcolor=white];
      f2__refine_plan__0 -> f2__refine_plan__1 [style=invis];
    }
    subgraph cluster_f2__review_plan {
      label="review_plan"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__review_plan__0 [label="handoff → pm-review", shape=box, fillcolor=plum];
    }
    subgraph cluster_f2__rewrite_epic {
      label="rewrite_epic"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__rewrite_epic__0 [label="rewrite-epic-edit.md\nRewrite epic prose after an approved graph edit", shape=note, fillcolor=lightyellow];
      f2__rewrite_epic__1 [label="validate_epic_document\nCheck the model-authored epic prose without re-parsing Ostler-owned graph metadata.", shape=box, fillcolor=white];
      f2__rewrite_epic__2 [label="validate_applied_edit\nProve disk matches the approved graph and unaffected story bodies remain byte-stable.", shape=box, fillcolor=white];
      f2__rewrite_epic__0 -> f2__rewrite_epic__1 [style=invis];
      f2__rewrite_epic__1 -> f2__rewrite_epic__2 [style=invis];
    }
    subgraph cluster_f2__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__start__0 [label="snapshot_epic\nCapture the graph and story-body baseline an edit is allowed to change.", shape=box, fillcolor=white];
    }
    subgraph cluster_f2__validate_plan {
      label="validate_plan"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__validate_plan__0 [label="validate_edit_plan\nReject an unsafe projected graph before any Ostler mutation runs.", shape=box, fillcolor=white];
    }
    f2____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f2____start -> f2__start__0 [lhead=cluster_f2__start];
    f2__apply_plan__1 -> f2__rewrite_epic__0 [label="plan applied", tooltip="edit", ltail=cluster_f2__apply_plan, lhead=cluster_f2__rewrite_epic];
    f2__apply_plan__1 -> f2__finish__0 [label="the epic was deleted", tooltip="edit", ltail=cluster_f2__apply_plan, lhead=cluster_f2__finish];
    f2__check_coverage__1 -> f2__finish__0 [label="coverage holds", tooltip="edit", ltail=cluster_f2__check_coverage, lhead=cluster_f2__finish];
    f2__design_mockup__1 -> f2__draft_story__0 [label="mockup drawn / no mockup needed", tooltip="edit, pick, index, mockup", ltail=cluster_f2__design_mockup, lhead=cluster_f2__draft_story];
    f2__draft_story__0 -> f2__next_affected_story__0 [label="the PM passed the story", tooltip="edit, index", ltail=cluster_f2__draft_story, lhead=cluster_f2__next_affected_story];
    f2__draft_story__0 -> f2__draft_story__0 [label="the story stayed blocked", tooltip="edit, pick, index, mockup", style=dashed, color=darkorange];
    f2__finish__2 -> f2____end [label="edit committed", color=darkgoldenrod, ltail=cluster_f2__finish];
    f2__next_affected_story__1 -> f2__design_mockup__0 [label="a story to rewrite", tooltip="edit, pick, index", ltail=cluster_f2__next_affected_story, lhead=cluster_f2__design_mockup];
    f2__next_affected_story__1 -> f2__check_coverage__0 [label="no story left", tooltip="edit", ltail=cluster_f2__next_affected_story, lhead=cluster_f2__check_coverage];
    f2__plan_edit__1 -> f2__validate_plan__0 [label="planned", tooltip="edit", ltail=cluster_f2__plan_edit, lhead=cluster_f2__validate_plan];
    f2__refine_plan__1 -> f2__validate_plan__0 [label="refined", tooltip="edit, reworks", ltail=cluster_f2__refine_plan, lhead=cluster_f2__validate_plan];
    f2__review_plan__0 -> f2__plan_edit__0 [label="out of plan reworks", tooltip="edit", style=dashed, color=darkorange, ltail=cluster_f2__review_plan, lhead=cluster_f2__plan_edit];
    f2__review_plan__0 -> f2__apply_plan__0 [label="the PM passed the plan", tooltip="edit", ltail=cluster_f2__review_plan, lhead=cluster_f2__apply_plan];
    f2__review_plan__0 -> f2__refine_plan__0 [label="the PM has findings", tooltip="edit, findings, reworks", ltail=cluster_f2__review_plan, lhead=cluster_f2__refine_plan];
    f2__rewrite_epic__2 -> f2__rewrite_epic__0 [label="blocked or out of reworks / the epic has findings", tooltip="edit, findings, reworks", style=dashed, color=darkorange];
    f2__rewrite_epic__2 -> f2__next_affected_story__0 [label="the epic reads right", tooltip="edit, index", ltail=cluster_f2__rewrite_epic, lhead=cluster_f2__next_affected_story];
    f2__start__0 -> f2__plan_edit__0 [label="baseline taken", tooltip="edit", ltail=cluster_f2__start, lhead=cluster_f2__plan_edit];
    f2__validate_plan__0 -> f2__refine_plan__0 [label="the plan has findings", tooltip="edit, findings, reworks", ltail=cluster_f2__validate_plan, lhead=cluster_f2__refine_plan];
    f2__validate_plan__0 -> f2__review_plan__0 [label="the plan is valid", tooltip="edit, reworks", ltail=cluster_f2__validate_plan, lhead=cluster_f2__review_plan];
    f2__validate_plan__0 -> f2__plan_edit__0 [label="out of plan reworks", tooltip="edit", style=dashed, color=darkorange, ltail=cluster_f2__validate_plan, lhead=cluster_f2__plan_edit];
  }

  subgraph cluster_story_edit_f3__ {
    label="story-edit";
    style=dashed; color=gray50; fontsize=11;

    f3____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f3__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f3__start__0 [label="resolve_story_intent\nValidate the requested story operation and name its parent epic and binding outcome.", shape=box, fillcolor=white];
      f3__start__1 [label="handoff → epic-edit", shape=box, fillcolor=plum];
      f3__start__0 -> f3__start__1 [style=invis];
    }
    f3____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f3____start -> f3__start__0 [lhead=cluster_f3__start];
    f3__start__1 -> f3____end [label="the epic edit ran", color=darkgoldenrod, ltail=cluster_f3__start];
  }

  subgraph cluster_epic_split_f4__ {
    label="epic-split";
    style=dashed; color=gray50; fontsize=11;

    f4____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f4__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f4__start__0 [label="handoff → draft", shape=box, fillcolor=plum];
      f4__start__1 [label="validate_epic_split\nValidate an ordered, non-empty epic list without accepting prose, seeds, or stories.", shape=box, fillcolor=white];
      f4__start__0 -> f4__start__1 [style=invis];
    }
    f4____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f4____start -> f4__start__0 [lhead=cluster_f4__start];
    f4__start__1 -> f4____end [label="the PM passed the split / the split stayed blocked", color=darkgoldenrod, ltail=cluster_f4__start];
  }

  subgraph cluster_epic_author_f5__ {
    label="epic-author";
    style=dashed; color=gray50; fontsize=11;

    f5____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f5__ask_pm {
      label="ask_pm"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f5__ask_pm__0 [label="handoff → gap-answer", shape=box, fillcolor=plum];
    }
    subgraph cluster_f5__author_epic {
      label="author_epic"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f5__author_epic__0 [label="write-epic.md\nWrite the epic: `{{ workhorse_var('epic') }}`", shape=note, fillcolor=lightyellow];
      f5__author_epic__1 [label="validate_authored_epic\nApply the main worklist's documented-epic evidence to one explicit epic.", shape=box, fillcolor=white];
      f5__author_epic__0 -> f5__author_epic__1 [style=invis];
    }
    f5__start [label="start"];
    f5____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f5____start -> f5__start;
    f5__ask_pm__0 -> f5__author_epic__0 [label="the PM answered", tooltip="draft", ltail=cluster_f5__ask_pm, lhead=cluster_f5__author_epic];
    f5__author_epic__1 -> f5____end [label="the epic validates / out of budget", color=darkgoldenrod, ltail=cluster_f5__author_epic];
    f5__author_epic__1 -> f5__ask_pm__0 [label="the writer has a question", tooltip="question, draft", ltail=cluster_f5__author_epic, lhead=cluster_f5__ask_pm];
    f5__author_epic__1 -> f5__author_epic__0 [label="the epic failed validation", tooltip="draft"];
    f5__start -> f5__author_epic__0 [label="nothing written yet", tooltip="draft", lhead=cluster_f5__author_epic];
  }

  subgraph cluster_story_split_f6__ {
    label="story-split";
    style=dashed; color=gray50; fontsize=11;

    f6____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f6__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f6__start__0 [label="handoff → draft", shape=box, fillcolor=plum];
    }
    f6____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f6____start -> f6__start__0 [lhead=cluster_f6__start];
