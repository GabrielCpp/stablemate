    f3__start [label="start\ncall snapshot_epic"];
    f3__validate_plan [label="validate_plan\ncall validate_edit_plan"];
    f3__write_story [label="write_story\nagent write-story.md"];
    f3____end [label="END → back to start", shape=doublecircle, fillcolor=lightgreen, width=0.4];

    f3____start -> f3__start;
    f3__apply_plan -> f3__rewrite_epic [label="intent, snapshot, plan, applied"];
    f3__apply_plan -> f3__finish [label="intent, applied"];
    f3__audit_story -> f3__next_affected_story [label="intent, applied, index"];
    f3__audit_story -> f3__rework_story [label="intent, applied, pick, index, mockup, findings, reworks"];
    f3__audit_story -> f3__write_story [label="intent, applied, pick, index, mockup, reworks", style=dashed, color=darkorange];
    f3__check_coverage -> f3__finish [label="intent, applied"];
    f3__check_story -> f3__audit_story [label="intent, applied, pick, index, mockup, reworks"];
    f3__check_story -> f3__check_story [label="intent, applied, pick, index, mockup, reworks"];
    f3__check_story -> f3__write_story [label="intent, applied, pick, index, mockup, reworks", style=dashed, color=darkorange];
    f3__design_mockup -> f3__write_story [label="intent, applied, pick, index, mockup"];
    f3__finish -> f3____end [color=darkgreen];
    f3__next_affected_story -> f3__design_mockup [label="intent, applied, pick, index"];
    f3__next_affected_story -> f3__check_coverage [label="intent, applied"];
    f3__plan_edit -> f3__validate_plan [label="intent, snapshot, plan"];
    f3__refine_plan -> f3__validate_plan [label="intent, snapshot, plan, reworks"];
    f3__review_plan -> f3__plan_edit [label="intent, snapshot", style=dashed, color=darkorange];
    f3__review_plan -> f3__apply_plan [label="intent, snapshot, plan"];
    f3__review_plan -> f3__refine_plan [label="intent, snapshot, plan, findings, reworks"];
    f3__rework_story -> f3__check_story [label="intent, applied, pick, index, mockup, reworks"];
    f3__rewrite_epic -> f3__rewrite_epic [label="intent, snapshot, plan, applied, findings, reworks", style=dashed, color=darkorange];
    f3__rewrite_epic -> f3__next_affected_story [label="intent, applied, index"];
    f3__rewrite_epic -> f3__rewrite_epic [label="intent, snapshot, plan, applied, findings, reworks"];
    f3__start -> f3__plan_edit [label="intent, snapshot"];
    f3__validate_plan -> f3__refine_plan [label="intent, snapshot, plan, findings, reworks"];
    f3__validate_plan -> f3__review_plan [label="intent, snapshot, plan, reworks"];
    f3__validate_plan -> f3__plan_edit [label="intent, snapshot", style=dashed, color=darkorange];
    f3__write_story -> f3__check_story [label="intent, applied, pick, index, mockup, reworks"];
    f3__write_story -> f3__write_story [label="intent, applied, pick, index, mockup, reworks", style=dashed, color=darkorange];
    f3____end -> f4__start [style=dashed, color=gray40];
