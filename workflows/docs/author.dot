digraph author {
  rankdir=TB;
  bgcolor=white;
  compound=true;
  newrank=true;
  node [shape=box, style="rounded,filled", fillcolor=lightblue];
  edge [color=darkblue, fontsize=10];

  subgraph cluster_default_f0__ {
    label="default";
    style=dashed; color=gray50; fontsize=11;

    f0____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    f0__answered_split [label="answered_split"];
    subgraph cluster_f0__author_epic {
      label="author_epic"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__author_epic__0 [label="handoff → epic-author", shape=box, fillcolor=plum];
    }
    subgraph cluster_f0__author_story {
      label="author_story"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__author_story__0 [label="handoff → story-author", shape=box, fillcolor=plum];
    }
    subgraph cluster_f0__complete {
      label="complete"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__complete__0 [label="check_completion\nWhether the milestone body still matches *baseline*, and every work-list row not yet done.", shape=box, fillcolor=white];
      f0__complete__1 [label="handoff → finalize", shape=box, fillcolor=plum];
      f0__complete__0 -> f0__complete__1 [style=invis];
    }
    f0__epics [label="epics"];
    subgraph cluster_f0__fill_epics {
      label="fill_epics"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__fill_epics__0 [label="fill_work\nFile every item of *kind* the planning graph holds, satisfied ones as done, skipping ids already filed.", shape=box, fillcolor=white];
    }
    subgraph cluster_f0__fill_stories {
      label="fill_stories"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__fill_stories__0 [label="fill_work\nFile every item of *kind* the planning graph holds, satisfied ones as done, skipping ids already filed.", shape=box, fillcolor=white];
    }
    subgraph cluster_f0__fill_story_splits {
      label="fill_story_splits"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__fill_story_splits__0 [label="fill_work\nFile every item of *kind* the planning graph holds, satisfied ones as done, skipping ids already filed.", shape=box, fillcolor=white];
    }
    f0__requeue [label="requeue"];
    subgraph cluster_f0__split_epic_stories {
      label="split_epic_stories"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__split_epic_stories__0 [label="handoff → story-split", shape=box, fillcolor=plum];
    }
    subgraph cluster_f0__split_epics {
      label="split_epics"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__split_epics__0 [label="handoff → epic-split", shape=box, fillcolor=plum];
      f0__split_epics__1 [label="check_epic_split\nWhether the approved milestone already has a valid ordered epic split.", shape=box, fillcolor=white];
      f0__split_epics__0 -> f0__split_epics__1 [style=invis];
    }
    subgraph cluster_f0__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__start__0 [label="contract_digest\nThe sha256 of the milestone body, which the run never writes, so a change is an operator's edit.", shape=box, fillcolor=white];
      f0__start__1 [label="snapshot_epics\nEach epic's seed ids and story slugs as the run found them, for the reconcile gate to measure drops against.", shape=box, fillcolor=white];
      f0__start__2 [label="seed_story\nRegister ONE register record as a new story inside an already-existing epic.", shape=box, fillcolor=white];
      f0__start__3 [label="derive_story_services\nA story's services stay inside the sorted union of the services of the seeds it covers.", shape=box, fillcolor=white];
      f0__start__4 [label="handoff → story-author", shape=box, fillcolor=plum];
      f0__start__5 [label="handoff → parity-surveyor", shape=box, fillcolor=plum];
      f0__start__6 [label="promote_record\nClose the record a story was authored from as promoted, naming the story and its epic.", shape=box, fillcolor=white];
      f0__start__0 -> f0__start__1 [style=invis];
      f0__start__1 -> f0__start__2 [style=invis];
      f0__start__2 -> f0__start__3 [style=invis];
      f0__start__3 -> f0__start__4 [style=invis];
      f0__start__4 -> f0__start__5 [style=invis];
      f0__start__5 -> f0__start__6 [style=invis];
    }
    f0__stories [label="stories"];
    f0__story_splits [label="story_splits"];
    f0____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f0____start -> f0__start__0 [lhead=cluster_f0__start];
    f0__answered_split -> f0__split_epics__0 [tooltip="note", lhead=cluster_f0__split_epics];
    f0__author_epic__0 -> f0__epics [ltail=cluster_f0__author_epic];
    f0__author_story__0 -> f0__stories [ltail=cluster_f0__author_story];
    f0__complete__1 -> f0____end [color=darkgoldenrod, ltail=cluster_f0__complete];
    f0__complete__1 -> f0__complete__0 [tooltip="baseline", style=dashed, color=darkorange];
    f0__complete__1 -> f0__requeue [tooltip="ids, question", style=dashed, color=darkorange, ltail=cluster_f0__complete];
    f0__epics -> f0__epics [label="another chunk"];
    f0__epics -> f0__author_epic__0 [label="drain target", tooltip="items", lhead=cluster_f0__author_epic];
    f0__epics -> f0__fill_story_splits__0 [lhead=cluster_f0__fill_story_splits];
    f0__fill_epics__0 -> f0__epics [ltail=cluster_f0__fill_epics];
    f0__fill_stories__0 -> f0__stories [ltail=cluster_f0__fill_stories];
    f0__fill_story_splits__0 -> f0__story_splits [ltail=cluster_f0__fill_story_splits];
    f0__requeue -> f0__split_epics__0 [lhead=cluster_f0__split_epics];
    f0__split_epic_stories__0 -> f0__story_splits [ltail=cluster_f0__split_epic_stories];
    f0__split_epics__1 -> f0__fill_epics__0 [ltail=cluster_f0__split_epics, lhead=cluster_f0__fill_epics];
    f0__split_epics__1 -> f0__answered_split [tooltip="question", style=dashed, color=darkorange, ltail=cluster_f0__split_epics];
    f0__start__6 -> f0__split_epics__0 [ltail=cluster_f0__start, lhead=cluster_f0__split_epics];
    f0__start__6 -> f0____end [color=darkgoldenrod, ltail=cluster_f0__start];
    f0__stories -> f0__stories [label="another chunk"];
    f0__stories -> f0__author_story__0 [label="drain target", tooltip="items", lhead=cluster_f0__author_story];
    f0__stories -> f0__complete__0 [lhead=cluster_f0__complete];
    f0__story_splits -> f0__story_splits [label="another chunk"];
    f0__story_splits -> f0__split_epic_stories__0 [label="drain target", tooltip="items", lhead=cluster_f0__split_epic_stories];
    f0__story_splits -> f0__fill_stories__0 [lhead=cluster_f0__fill_stories];
  }

  subgraph cluster_parity_surveyor_f1__ {
    label="parity-surveyor";
    style=dashed; color=gray50; fontsize=11;

    f1____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f1__assess {
      label="assess"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__assess__0 [label="read_parity_register\nThe open records of the surveyed repository, for the assessor to match a surface against.", shape=box, fillcolor=white];
      f1__assess__1 [label="assess-parity-unit.md\nCompare one baseline surface with the current service books", shape=note, fillcolor=lightyellow];
      f1__assess__0 -> f1__assess__1 [style=invis];
    }
    subgraph cluster_f1__emit {
      label="emit"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__emit__0 [label="emit_parity_records\nOne register record per assessed surface that no new-app feature already owns.", shape=box, fillcolor=white];
    }
    subgraph cluster_f1__mark {
      label="mark"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__mark__0 [label="validate_record\nCheck one unit's finding record, hard and deterministically.", shape=box, fillcolor=white];
      f1__mark__1 [label="mark_unit\nStamp the unit's inventory entry with its (validated) record's status.", shape=box, fillcolor=white];
      f1__mark__0 -> f1__mark__1 [style=invis];
    }
    subgraph cluster_f1__pick {
      label="pick"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__pick__0 [label="select_next_unit\nThe first unit still `pending`, or the news that none is left.", shape=box, fillcolor=white];
    }
    subgraph cluster_f1__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__start__0 [label="expand_parity_inventory\nFreeze one survey unit per baseline surface.", shape=box, fillcolor=white];
    }
    subgraph cluster_f1__verify {
      label="verify"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__verify__0 [label="verify_records\nThe coverage gate: every frozen unit accounted for, and no silent shrinkage.", shape=box, fillcolor=white];
    }
    f1____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f1____start -> f1__start__0 [lhead=cluster_f1__start];
    f1__assess__1 -> f1__mark__0 [tooltip="unit_id, record_path", ltail=cluster_f1__assess, lhead=cluster_f1__mark];
    f1__emit__0 -> f1____end [color=darkgoldenrod, ltail=cluster_f1__emit];
    f1__mark__1 -> f1__pick__0 [ltail=cluster_f1__mark, lhead=cluster_f1__pick];
    f1__pick__0 -> f1__assess__0 [tooltip="unit_id, unit_path, unit_kind, record_path, progress", ltail=cluster_f1__pick, lhead=cluster_f1__assess];
    f1__pick__0 -> f1__verify__0 [ltail=cluster_f1__pick, lhead=cluster_f1__verify];
    f1__start__0 -> f1__pick__0 [ltail=cluster_f1__start, lhead=cluster_f1__pick];
    f1__verify__0 -> f1__emit__0 [ltail=cluster_f1__verify, lhead=cluster_f1__emit];
  }

  subgraph cluster_epic_edit_f2__ {
    label="epic-edit";
    style=dashed; color=gray50; fontsize=11;

    f2____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f2__apply_plan {
      label="apply_plan"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__apply_plan__0 [label="apply_edit_plan\nApply one validated plan idempotently through Ostler's structural APIs.", shape=box, fillcolor=white];
      f2__apply_plan__1 [label="validate_applied_edit\nProve disk matches the approved graph and unaffected story bodies remain byte-stable.", shape=box, fillcolor=white];
      f2__apply_plan__0 -> f2__apply_plan__1 [style=invis];
    }
    subgraph cluster_f2__check_coverage {
      label="check_coverage"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__check_coverage__0 [label="validate_coverage\nEvery seed covered by a story, the story graph acyclic, every story file present.", shape=box, fillcolor=white];
      f2__check_coverage__1 [label="handoff → pm-review", shape=box, fillcolor=plum];
      f2__check_coverage__0 -> f2__check_coverage__1 [style=invis];
    }
    subgraph cluster_f2__check_story {
      label="check_story"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__check_story__0 [label="validate_story\nThe bare-minimum story contract, checked deterministically.", shape=box, fillcolor=white];
      f2__check_story__1 [label="check_story_grounding\nDoes every seed the story claims belong to its epic?", shape=box, fillcolor=white];
      f2__check_story__2 [label="record_attempt\nAppend this attempt's failure to the story's attempts ledger, and read it back.", shape=box, fillcolor=white];
      f2__check_story__3 [label="rework-story.md\nRework the story: `{{ workhorse_var('story_slug') }}`", shape=note, fillcolor=lightyellow];
      f2__check_story__0 -> f2__check_story__1 [style=invis];
      f2__check_story__1 -> f2__check_story__2 [style=invis];
      f2__check_story__2 -> f2__check_story__3 [style=invis];
    }
    subgraph cluster_f2__design_mockup {
      label="design_mockup"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__design_mockup__0 [label="design-mockup.md\nDesign a mockup for a new screen: `{{ workhorse_var('story_slug') }}`", shape=note, fillcolor=lightyellow];
      f2__design_mockup__1 [label="check_mockup_needed\nA story needs a mockup exactly when one of its services is a UI book.", shape=box, fillcolor=white];
      f2__design_mockup__0 -> f2__design_mockup__1 [style=invis];
    }
    subgraph cluster_f2__finish {
      label="finish"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__finish__0 [label="verify_integrity\n`ostler doctor` over the whole graph, as a blocking gate.", shape=box, fillcolor=white];
      f2__finish__1 [label="commit_author\nCommit the epic/story docs this run wrote, in the one repo it wrote them in.", shape=box, fillcolor=white];
      f2__finish__2 [label="promote_record\nClose the record a story was authored from as promoted, naming the story and its epic.", shape=box, fillcolor=white];
      f2__finish__0 -> f2__finish__1 [style=invis];
      f2__finish__1 -> f2__finish__2 [style=invis];
    }
    subgraph cluster_f2__next_affected_story {
      label="next_affected_story"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__next_affected_story__0 [label="select_affected_story\nResolve the next approved affected story without widening the edit worklist.", shape=box, fillcolor=white];
      f2__next_affected_story__1 [label="derive_story_services\nA story's services stay inside the sorted union of the services of the seeds it covers.", shape=box, fillcolor=white];
      f2__next_affected_story__0 -> f2__next_affected_story__1 [style=invis];
    }
    subgraph cluster_f2__plan_edit {
      label="plan_edit"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__plan_edit__0 [label="plan-epic-edit.md\nPlan an edit to epic `{{ workhorse_var('snapshot').epic }}`", shape=note, fillcolor=lightyellow];
      f2__plan_edit__1 [label="read_register_listing\nThe open records of every repository, one line each under a header, for the planner to read.", shape=box, fillcolor=white];
      f2__plan_edit__0 -> f2__plan_edit__1 [style=invis];
    }
    subgraph cluster_f2__refine_plan {
      label="refine_plan"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__refine_plan__0 [label="refine-epic-edit-plan.md\nRefine an invalid epic edit plan", shape=note, fillcolor=lightyellow];
      f2__refine_plan__1 [label="read_register_listing\nThe open records of every repository, one line each under a header, for the planner to read.", shape=box, fillcolor=white];
      f2__refine_plan__0 -> f2__refine_plan__1 [style=invis];
    }
    subgraph cluster_f2__review_plan {
      label="review_plan"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__review_plan__0 [label="handoff → pm-review", shape=box, fillcolor=plum];
    }
    subgraph cluster_f2__review_story {
      label="review_story"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__review_story__0 [label="handoff → pm-review", shape=box, fillcolor=plum];
    }
    subgraph cluster_f2__rework_story {
      label="rework_story"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__rework_story__0 [label="record_attempt\nAppend this attempt's failure to the story's attempts ledger, and read it back.", shape=box, fillcolor=white];
      f2__rework_story__1 [label="rework-story.md\nRework the story: `{{ workhorse_var('story_slug') }}`", shape=note, fillcolor=lightyellow];
      f2__rework_story__0 -> f2__rework_story__1 [style=invis];
    }
    subgraph cluster_f2__rewrite_epic {
      label="rewrite_epic"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__rewrite_epic__0 [label="rewrite-epic-edit.md\nRewrite epic prose after an approved graph edit", shape=note, fillcolor=lightyellow];
      f2__rewrite_epic__1 [label="validate_epic_document\nCheck the model-authored epic prose without re-parsing Ostler-owned graph metadata.", shape=box, fillcolor=white];
      f2__rewrite_epic__2 [label="validate_applied_edit\nProve disk matches the approved graph and unaffected story bodies remain byte-stable.", shape=box, fillcolor=white];
      f2__rewrite_epic__0 -> f2__rewrite_epic__1 [style=invis];
      f2__rewrite_epic__1 -> f2__rewrite_epic__2 [style=invis];
    }
    subgraph cluster_f2__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__start__0 [label="snapshot_epic\nCapture the graph and story-body baseline an edit is allowed to change.", shape=box, fillcolor=white];
    }
    subgraph cluster_f2__validate_plan {
      label="validate_plan"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__validate_plan__0 [label="validate_edit_plan\nReject an unsafe projected graph before any Ostler mutation runs.", shape=box, fillcolor=white];
    }
    subgraph cluster_f2__write_story {
      label="write_story"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f2__write_story__0 [label="write-story.md\nWrite the story: `{{ workhorse_var('story_slug') }}`", shape=note, fillcolor=lightyellow];
    }
    f2____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f2____start -> f2__start__0 [lhead=cluster_f2__start];
    f2__apply_plan__1 -> f2__rewrite_epic__0 [tooltip="intent, snapshot, plan, applied", ltail=cluster_f2__apply_plan, lhead=cluster_f2__rewrite_epic];
    f2__apply_plan__1 -> f2__finish__0 [tooltip="intent, applied", ltail=cluster_f2__apply_plan, lhead=cluster_f2__finish];
    f2__check_coverage__1 -> f2__finish__0 [tooltip="intent, applied", ltail=cluster_f2__check_coverage, lhead=cluster_f2__finish];
    f2__check_story__3 -> f2__review_story__0 [tooltip="intent, applied, pick, index, mockup, reworks, prior", ltail=cluster_f2__check_story, lhead=cluster_f2__review_story];
    f2__check_story__3 -> f2__check_story__0 [tooltip="intent, applied, pick, index, mockup, reworks, prior"];
    f2__check_story__3 -> f2__write_story__0 [tooltip="intent, applied, pick, index, mockup, reworks", style=dashed, color=darkorange, ltail=cluster_f2__check_story, lhead=cluster_f2__write_story];
    f2__design_mockup__1 -> f2__write_story__0 [tooltip="intent, applied, pick, index, mockup", ltail=cluster_f2__design_mockup, lhead=cluster_f2__write_story];
    f2__finish__2 -> f2____end [color=darkgoldenrod, ltail=cluster_f2__finish];
    f2__next_affected_story__1 -> f2__design_mockup__0 [tooltip="intent, applied, pick, index", ltail=cluster_f2__next_affected_story, lhead=cluster_f2__design_mockup];
    f2__next_affected_story__1 -> f2__check_coverage__0 [tooltip="intent, applied", ltail=cluster_f2__next_affected_story, lhead=cluster_f2__check_coverage];
    f2__plan_edit__1 -> f2__validate_plan__0 [tooltip="intent, snapshot, plan", ltail=cluster_f2__plan_edit, lhead=cluster_f2__validate_plan];
    f2__refine_plan__1 -> f2__validate_plan__0 [tooltip="intent, snapshot, plan, reworks", ltail=cluster_f2__refine_plan, lhead=cluster_f2__validate_plan];
    f2__review_plan__0 -> f2__plan_edit__0 [tooltip="intent, snapshot", style=dashed, color=darkorange, ltail=cluster_f2__review_plan, lhead=cluster_f2__plan_edit];
    f2__review_plan__0 -> f2__apply_plan__0 [tooltip="intent, snapshot, plan", ltail=cluster_f2__review_plan, lhead=cluster_f2__apply_plan];
    f2__review_plan__0 -> f2__refine_plan__0 [tooltip="intent, snapshot, plan, findings, reworks", ltail=cluster_f2__review_plan, lhead=cluster_f2__refine_plan];
