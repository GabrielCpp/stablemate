digraph okf_builder {
  rankdir=TB;
  bgcolor=white;
  compound=true;
  newrank=true;
  node [shape=box, style="rounded,filled", fillcolor=lightblue];
  edge [color=darkblue, fontsize=10];

  subgraph cluster_default_f0__ {
    label="default";
    style=dashed; color=gray50; fontsize=11;

    f0____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f0__adjudicate {
      label="adjudicate"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__adjudicate__0 [label="blocked_rows\nThe blocked rows still waiting for a side — a row already adjudicated keeps its", shape=box, fillcolor=white];
      f0__adjudicate__1 [label="settle_stale\nMid-drain, reconcile the repair rows against doctor: close the open rows it no longer", shape=box, fillcolor=white];
      f0__adjudicate__2 [label="record\nMark the current item done, merge newly-discovered items, and count the re-tries.", shape=box, fillcolor=white];
      f0__adjudicate__3 [label="gather_evidence\nRead the other side: the story the node's code was last written to, and its text.", shape=box, fillcolor=white];
      f0__adjudicate__4 [label="adjudicate.md\nadjudicate one blocked finding: which side is wrong?", shape=note, fillcolor=lightyellow];
      f0__adjudicate__5 [label="apply_verdict\nRoute one verdict. Every branch writes the verdict and the chain on the row.", shape=box, fillcolor=white];
      f0__adjudicate__0 -> f0__adjudicate__1 [color=gray40, arrowsize=0.6];
      f0__adjudicate__1 -> f0__adjudicate__2 [color=gray40, arrowsize=0.6];
      f0__adjudicate__2 -> f0__adjudicate__3 [color=gray40, arrowsize=0.6];
      f0__adjudicate__3 -> f0__adjudicate__4 [color=gray40, arrowsize=0.6];
      f0__adjudicate__4 -> f0__adjudicate__5 [color=gray40, arrowsize=0.6];
    }
    subgraph cluster_f0__checkpoint {
      label="checkpoint"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__checkpoint__0 [label="checkpoint_book\nCanonicalize the book, then read doctor, then queue the repairs it names.", shape=box, fillcolor=white];
      f0__checkpoint__1 [label="record\nMark the current item done, merge newly-discovered items, and count the re-tries.", shape=box, fillcolor=white];
      f0__checkpoint__0 -> f0__checkpoint__1 [color=gray40, arrowsize=0.6];
    }
    subgraph cluster_f0__commit {
      label="commit"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__commit__0 [label="commit_book\nCommit only the completed service book, with optional story provenance.", shape=box, fillcolor=white];
    }
    subgraph cluster_f0__investigate {
      label="investigate"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__investigate__0 [label="commit_turn\nCommit whatever changed in the book, under `subject`; never fail the run.", shape=box, fillcolor=white];
      f0__investigate__1 [label="stamp_turn\nStamp exactly the `@digest` targets this turn earned, gated by the turn's own errors.", shape=box, fillcolor=white];
      f0__investigate__2 [label="snapshot_book\nReplace `dest` with a copy of the book under `features_root`, as it stands now.", shape=box, fillcolor=white];
      f0__investigate__0 -> f0__investigate__1 [color=gray40, arrowsize=0.6];
      f0__investigate__1 -> f0__investigate__2 [color=gray40, arrowsize=0.6];
    }
    subgraph cluster_f0__recheck {
      label="recheck"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__recheck__0 [label="recheck-coverage.md\ncoverage re-scan (the exhaustiveness backstop)", shape=note, fillcolor=lightyellow];
    }
    subgraph cluster_f0__record_item {
      label="record_item"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__record_item__0 [label="record\nMark the current item done, merge newly-discovered items, and count the re-tries.", shape=box, fillcolor=white];
    }
    f0__refuel [label="refuel"];
    subgraph cluster_f0__rescan_coverage {
      label="rescan_coverage"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__rescan_coverage__0 [label="inventory_source\nMaterialize a deterministic multi-language source inventory for OKF coverage.", shape=box, fillcolor=white];
      f0__rescan_coverage__1 [label="compute_coverage\nCompute the book's coverage — the verdict the agent used to emit.", shape=box, fillcolor=white];
      f0__rescan_coverage__2 [label="record\nMark the current item done, merge newly-discovered items, and count the re-tries.", shape=box, fillcolor=white];
      f0__rescan_coverage__0 -> f0__rescan_coverage__1 [color=gray40, arrowsize=0.6];
      f0__rescan_coverage__1 -> f0__rescan_coverage__2 [color=gray40, arrowsize=0.6];
    }
    subgraph cluster_f0__retry_blocked {
      label="retry_blocked"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__retry_blocked__0 [label="settle_stale\nMid-drain, reconcile the repair rows against doctor: close the open rows it no longer", shape=box, fillcolor=white];
      f0__retry_blocked__1 [label="record\nMark the current item done, merge newly-discovered items, and count the re-tries.", shape=box, fillcolor=white];
      f0__retry_blocked__0 -> f0__retry_blocked__1 [color=gray40, arrowsize=0.6];
    }
    subgraph cluster_f0__seed_recheck {
      label="seed_recheck"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__seed_recheck__0 [label="record\nMark the current item done, merge newly-discovered items, and count the re-tries.", shape=box, fillcolor=white];
    }
    subgraph cluster_f0__select {
      label="select"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__select__0 [label="settle_stale\nMid-drain, reconcile the repair rows against doctor: close the open rows it no longer", shape=box, fillcolor=white];
      f0__select__1 [label="select_item\nPop the next pending item and mark it active.", shape=box, fillcolor=white];
      f0__select__2 [label="checkpoint_book\nCanonicalize the book, then read doctor, then queue the repairs it names.", shape=box, fillcolor=white];
      f0__select__0 -> f0__select__1 [color=gray40, arrowsize=0.6];
      f0__select__1 -> f0__select__2 [color=gray40, arrowsize=0.6];
    }
    subgraph cluster_f0__semantic_audit {
      label="semantic_audit"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f0__semantic_audit__0 [label="handoff → live-audit", shape=box, fillcolor=plum];
    }
    f0__start [label="start"];
    f0____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f0____start -> f0__start;
    f0__adjudicate__5 -> f0__checkpoint__0 [label="every row closed: re-read doctor", ltail=cluster_f0__adjudicate, lhead=cluster_f0__checkpoint];
    f0__adjudicate__5 -> f0__adjudicate__0 [label="verdict applied: next blocked row"];
    f0__adjudicate__5 -> f0__select__0 [label="a book verdict re-queued rows", ltail=cluster_f0__adjudicate, lhead=cluster_f0__select];
    f0__adjudicate__5 -> f0__retry_blocked__0 [label="rows still blocked after verdicts: operator gate", style=dashed, color=darkorange, ltail=cluster_f0__adjudicate, lhead=cluster_f0__retry_blocked];
    f0__adjudicate__5 -> f0__adjudicate__0 [label="adjudication turn unusable: operator gate", style=dashed, color=darkorange];
    f0__checkpoint__1 -> f0__rescan_coverage__0 [label="doctor clean: check the inventory", ltail=cluster_f0__checkpoint, lhead=cluster_f0__rescan_coverage];
    f0__checkpoint__1 -> f0__select__0 [label="doctor dirty: repairs queued", ltail=cluster_f0__checkpoint, lhead=cluster_f0__select];
    f0__checkpoint__1 -> f0__retry_blocked__0 [label="re-scan cap hit, coverage still incomplete: operator gate", style=dashed, color=darkorange, ltail=cluster_f0__checkpoint, lhead=cluster_f0__retry_blocked];
    f0__checkpoint__1 -> f0__adjudicate__0 [label="blocked rows and nothing pending: read the other side", ltail=cluster_f0__checkpoint, lhead=cluster_f0__adjudicate];
    f0__checkpoint__1 -> f0__retry_blocked__0 [label="findings unchanged for the stall cap: operator gate", style=dashed, color=darkorange, ltail=cluster_f0__checkpoint, lhead=cluster_f0__retry_blocked];
    f0__commit__0 -> f0____end [label="completed book committed", color=darkgoldenrod, ltail=cluster_f0__commit];
    f0__investigate__2 -> f0__record_item__0 [label="turn finished: record what it wrote", ltail=cluster_f0__investigate, lhead=cluster_f0__record_item];
    f0__recheck__0 -> f0__seed_recheck__0 [label="recheck verdicts in", ltail=cluster_f0__recheck, lhead=cluster_f0__seed_recheck];
    f0__record_item__0 -> f0__select__0 [label="item closed, discoveries opened", ltail=cluster_f0__record_item, lhead=cluster_f0__select];
    f0__refuel -> f0__select__0 [label="operator granted another allowance", lhead=cluster_f0__select];
    f0__rescan_coverage__2 -> f0__recheck__0 [label="uncovered units: ask whether they are units", ltail=cluster_f0__rescan_coverage, lhead=cluster_f0__recheck];
    f0__rescan_coverage__2 -> f0__semantic_audit__0 [label="inventory cited: audit behavior in both directions", ltail=cluster_f0__rescan_coverage, lhead=cluster_f0__semantic_audit];
    f0__rescan_coverage__2 -> f0__retry_blocked__0 [label="re-grounding rows all blocked and nothing uncovered: operator gate", style=dashed, color=darkorange, ltail=cluster_f0__rescan_coverage, lhead=cluster_f0__retry_blocked];
    f0__rescan_coverage__2 -> f0__select__0 [label="cited source moved: re-ground those nodes", ltail=cluster_f0__rescan_coverage, lhead=cluster_f0__select];
    f0__rescan_coverage__2 -> f0__recheck__0 [label="re-grounding rows all blocked: adjudicate the uncovered units", ltail=cluster_f0__rescan_coverage, lhead=cluster_f0__recheck];
    f0__retry_blocked__1 -> f0__select__0 [label="operator answered: blocked targets unblocked", ltail=cluster_f0__retry_blocked, lhead=cluster_f0__select];
    f0__seed_recheck__0 -> f0__select__0 [label="real gaps queued", ltail=cluster_f0__seed_recheck, lhead=cluster_f0__select];
    f0__select__2 -> f0__investigate__0 [label="next item picked", ltail=cluster_f0__select, lhead=cluster_f0__investigate];
    f0__select__2 -> f0__refuel [label="item ceiling hit with work pending: ask for more", style=dashed, color=darkorange, ltail=cluster_f0__select];
    f0__select__2 -> f0__checkpoint__0 [label="the drain is dry: run doctor", ltail=cluster_f0__select, lhead=cluster_f0__checkpoint];
    f0__semantic_audit__0 -> f0__commit__0 [label="live audit clear: commit the book", ltail=cluster_f0__semantic_audit, lhead=cluster_f0__commit];
    f0__semantic_audit__0 -> f0__semantic_audit__0 [label="live audit blocked or failing: operator gate", style=dashed, color=darkorange];
    f0__start -> f0__checkpoint__0 [label="empty book: same join seeds the worklist", lhead=cluster_f0__checkpoint];
    f0__start -> f0__checkpoint__0 [label="the book exists: reconcile it to HEAD", lhead=cluster_f0__checkpoint];
  }

  subgraph cluster_live_audit_f1__ {
    label="live-audit";
    style=dashed; color=gray50; fontsize=11;

    f1____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    subgraph cluster_f1__start {
      label="start"; fontsize=12;
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled", fontsize=10];
      f1__start__0 [label="discover_spec_dirs\nEvery spec directory under the book's `specs` root that declares a `qa_plan.py`.", shape=box, fillcolor=white];
      f1__start__1 [label="discover_compiled_targets\n`[BOOK_TARGET]` when the book serves something and no spec dir authors its own plan.", shape=box, fillcolor=white];
      f1__start__2 [label="audit_one_spec\nRun one spec directory's QA plan for real and fingerprint every scenario.", shape=box, fillcolor=white];
      f1__start__0 -> f1__start__1 [color=gray40, arrowsize=0.6];
      f1__start__1 -> f1__start__2 [color=gray40, arrowsize=0.6];
    }
    f1____end [label="END", shape=doublecircle, fillcolor=gold, width=0.4];

    f1____start -> f1__start__0 [lhead=cluster_f1__start];
    f1__start__2 -> f1____end [label="every spec dir's plan executed; blocked entries name the refusal reason", color=darkgoldenrod, ltail=cluster_f1__start];
  }

  subgraph cluster_legend {
    label="legend";
    style=dashed; color=gray50; fontsize=11;
    node [shape=plaintext, style="", fillcolor=white, fontsize=10];
    legend_a [label=""]; legend_b [label=""];
    legend_c [label=""]; legend_d [label=""];
    legend_e [label=""]; legend_f [label=""];
    legend_a -> legend_b [label="continue"];
    legend_c -> legend_d [label="await: parked on an operator gate", style=dashed, color=darkorange];
    legend_e -> legend_f [label="done: the flow ends", color=darkgoldenrod];
    subgraph cluster_legend_state {
      label="a state: what it runs, top to bottom";
      style="rounded,filled"; fillcolor=lightblue; color=steelblue;
      node [style="filled"];
      legend_call [label="a node call\nits docstring", shape=box, fillcolor=white];
      legend_agent [label="an agent turn: prompt.md\nits title", shape=note, fillcolor=lightyellow];
      legend_handoff [label="handoff → a sub-flow\nrun to its END, then back here", shape=box, fillcolor=plum];
      legend_call -> legend_agent -> legend_handoff [color=gray40, arrowsize=0.6];
    }
  }
}
