digraph okf_builder {
  rankdir=TB;
  bgcolor=white;
  node [shape=box, style="rounded,filled", fillcolor=lightblue];
  edge [color=darkblue, fontsize=10];

  subgraph cluster_default_f0__ {
    label="default";
    style=dashed; color=gray50; fontsize=11;

    f0____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    f0__adjudicate [label="adjudicate\ncall blocked_rows, record, gather_evidence, apply_verdict\nagent adjudicate.md"];
    f0__checkpoint [label="checkpoint\ncall checkpoint_book, record"];
    f0__enumerate_surfaces [label="enumerate_surfaces\nagent enumerate-surfaces.md"];
    f0__investigate [label="investigate"];
    f0__recheck [label="recheck\nagent recheck-coverage.md"];
    f0__record_item [label="record_item\ncall advance_watermark, record"];
    f0__refuel [label="refuel"];
    f0__rescan_coverage [label="rescan_coverage\ncall inventory_source, compute_coverage, record"];
    f0__retry_blocked [label="retry_blocked\ncall record"];
    f0__seed_recheck [label="seed_recheck\ncall record"];
    f0__seed_surfaces [label="seed_surfaces\ncall record"];
    f0__select [label="select\ncall select_item, checkpoint_book"];
    f0__start [label="start"];
    f0__walkthrough [label="walkthrough"];
    f0____end [label="END", shape=doublecircle, fillcolor=lightgreen, width=0.4];

    f0____start -> f0__start;
    f0__adjudicate -> f0__checkpoint [label="every row closed: re-read doctor"];
    f0__adjudicate -> f0__adjudicate [label="verdict applied: next blocked row"];
    f0__adjudicate -> f0__select [label="a book verdict re-queued rows"];
    f0__adjudicate -> f0__retry_blocked [label="rows still blocked after verdicts: operator gate", style=dashed, color=darkorange];
    f0__checkpoint -> f0__rescan_coverage [label="doctor clean: check the inventory"];
    f0__checkpoint -> f0__select [label="doctor dirty: repairs queued"];
    f0__checkpoint -> f0__rescan_coverage [label="re-scan cap hit, inventory still short: operator gate", style=dashed, color=darkorange];
    f0__checkpoint -> f0__adjudicate [label="blocked rows and nothing pending: read the other side"];
    f0__checkpoint -> f0__retry_blocked [label="findings unchanged for the stall cap: operator gate", style=dashed, color=darkorange];
    f0__enumerate_surfaces -> f0__seed_surfaces [label="entry surfaces discovered"];
    f0__investigate -> f0__record_item [label="turn finished: record what it wrote"];
    f0__recheck -> f0__seed_recheck [label="recheck verdicts in"];
    f0__record_item -> f0__select [label="item closed, discoveries opened"];
    f0__refuel -> f0__select [label="operator granted another allowance"];
    f0__rescan_coverage -> f0__recheck [label="uncovered units: ask whether they are units"];
    f0__rescan_coverage -> f0__walkthrough [label="inventory covered"];
    f0__rescan_coverage -> f0__select [label="cited source moved: re-ground those nodes"];
    f0__retry_blocked -> f0__select [label="operator answered: blocked targets unblocked"];
    f0__seed_recheck -> f0__select [label="real gaps queued"];
    f0__seed_surfaces -> f0__select [label="surfaces opened on the worklist"];
    f0__select -> f0__investigate [label="next item picked"];
    f0__select -> f0__refuel [label="item ceiling hit with work pending: ask for more", style=dashed, color=darkorange];
    f0__select -> f0__checkpoint [label="the drain is dry: run doctor"];
    f0__start -> f0__enumerate_surfaces [label="no book yet: fill it from the entry surfaces"];
    f0__start -> f0__checkpoint [label="the book exists: reconcile it to HEAD"];
    f0__walkthrough -> f0____end [label="book complete: walked when there is an app", color=darkgreen];
    f0__walkthrough -> f1____start [label="handoff", style=dashed, color=gray40];
  }

  subgraph cluster_walkthrough_web_f1__ {
    label="walkthrough-web";
    style=dashed; color=gray50; fontsize=11;

    f1____start [label="START", shape=circle, fillcolor=lightgreen, width=0.4];
    f1__checkpoint [label="checkpoint\ncall checkpoint_book, record, teardown_app, teardown_browser"];
    f1__mark [label="mark\ncall record"];
    f1__pick [label="pick\ncall select_item, teardown_app, teardown_browser"];
    f1__start [label="start\ncall boot_app, boot_browser, seed_walkthrough, teardown_app, …"];
    f1__walk [label="walk\nagent walkthrough-web.md"];
    f1____end [label="END → back to walkthrough", shape=doublecircle, fillcolor=lightgreen, width=0.4];

    f1____start -> f1__start;
    f1__checkpoint -> f1__pick [label="doctor dirty: fixups queued"];
    f1__checkpoint -> f1____end [label="app and browser reaped", color=darkgreen];
    f1__mark -> f1__pick [label="item closed, discoveries opened"];
    f1__pick -> f1__walk [label="next journey or screen"];
    f1__pick -> f1__checkpoint [label="drain dry: run doctor"];
    f1__pick -> f1____end [label="app and browser reaped", color=darkgreen];
    f1__start -> f1__pick [label="app and browser up: walk seeded"];
    f1__start -> f1____end [label="no screen surfaces: nothing to walk", color=darkgreen];
    f1__start -> f1____end [label="the app would not come up", color=darkgreen];
    f1__start -> f1____end [label="app and browser reaped", color=darkgreen];
    f1__walk -> f1__mark [label="walked: record it"];
    f1____end -> f0__walkthrough [style=dashed, color=gray40];
  }
}
