{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_no_shell.py\" --hook",
            "timeout": 10,
            "statusMessage": "Checking for ad-hoc shell scripts"
          }
        ]
      }
    ]
  }
}
