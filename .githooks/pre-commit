#!/bin/sh
# The private-name sweep no longer runs here. It is an agent commit check in the
# private-names policy, so only an agent's commit pays for it, and `make
# check-public` still sweeps the whole tree and history.
#
# Farrier appends its own fenced region below and `farrier install` rewrites it,
# so nothing here may `exec`. `set -eu` is what stops on a failure.
#
# Enable:  make hooks     (sets core.hooksPath to .githooks)
# Bypass:  git commit --no-verify
set -eu
# >>> farrier: hooks (generated) >>>
make farrier-run-hook
# <<< farrier: hooks <<<
