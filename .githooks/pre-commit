#!/bin/sh
# Block private overlay project names from entering this public repo.
#
# The names themselves are NOT here — scripts/private_names.py reads them from
# $STABLEMATE_PRIVATE_NAMES or $GIT_DIR/private-names, neither of which is
# tracked. With no list configured this hook is a no-op.
#
# /bin/sh, and one call into Python. The previous version was bash and used
# `mapfile`, which arrived in bash 4.0 — so on macOS, where /bin/bash is still
# 3.2, it died on an unbound array before it read a single name. A guard that
# fails on the platform its maintainer commits from is not a guard.
#
# The scan is the whole tracked tree rather than the staged diff, and it lives in
# scripts/check_public.py so that what blocks a commit and what fails `make test`
# are the same sweep over the same files. Whole-tree matters because this hook is
# the only enforcement point that exists: the names are untracked by construction,
# so a CI runner has none and the check skips there. A name that landed while the
# hook was uninstalled would otherwise stay in the tree forever — which is exactly
# how the leak that prompted this rewrite survived.
#
# `git ls-files` reads the index, so a file `git add`ed for this very commit is
# already in the scan set.
#
# Farrier appends its own fenced region below this script and `farrier install`
# rewrites it, so nothing here may `exec`: the sweep runs as a plain command and the
# fence runs after it. `set -eu` is what stops on a failure.
#
# Enable:  make hooks     (sets core.hooksPath to .githooks)
# Bypass:  git commit --no-verify
set -eu

repo_root=$(git rev-parse --show-toplevel)

# No `|| true` anywhere: a missing python3, an unreadable resolver or a crash must
# block the commit. The failure mode this repo cannot afford is a guard that passes
# because it never ran.
python3 "$repo_root/scripts/check_public.py" --names-only
# The same guard the Claude PreToolUse hook runs with --hook. That one covers an agent
# on a machine where it is installed; this covers everyone else, at the moment the file
# would enter the tree rather than whenever someone next runs `make test`.
python3 "$repo_root/scripts/check_no_shell.py"
# >>> farrier: hooks (generated) >>>
make farrier-run-hook
# <<< farrier: hooks <<<
