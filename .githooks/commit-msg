#!/usr/bin/env bash
# Two guards run on the commit message:
#
# 1. Conventional Commits format on the subject line (this script). Under
#    release-please the type is not a style preference — it is the input that decides
#    whether a package is released and at what version. A `chore:` that should have
#    been `fix:` ships nothing, silently, and the omission is only visible weeks later
#    when someone reports a bug against a version that never shipped the fix. A prompt
#    (Zed's generate-message, an agent's) can only bias; this decides.
#
# 2. No private overlay project names — the same denylist the tree sweep in
#    `.githooks/pre-commit` checks, against the message text instead of the staged
#    files. The names live in `scripts/private_names.py` and are untracked, so a CI
#    runner has none configured and the check is inert there — which is what the
#    pre-commit script also says, and for the same reason. A name leaked through a
#    commit message ships in `git log` for every clone that pulls the commit, which
#    is exactly how a name removed from the tree survives; this is the message half
#    of the same defense.
#
# The two guards share the file but each has its own pass: the bash side does the
# Conventional Commits regex, then the python side does the private-name grep.
# Either one failing blocks the commit (bash `set -e`, python exits non-zero on a
# hit). Run order matters: if the private-name guard runs first and fails, the
# Conventional Commits guard never gets a chance to suggest a correct type — a name
# in the subject is a leak first and a typo second, so the message above the leak
# is the right thing to lead with.
#
# Enable:  make hooks     (sets core.hooksPath to .githooks)
# Bypass:  git commit --no-verify
set -euo pipefail

msg_file="$1"

repo_root="$(git rev-parse --show-toplevel)"
# Block 2 first: a private name in the message is the more serious problem and the
# one release-please will not catch. Stop before the Conventional Commits pass would
# complain about a subject that is about to be replaced anyway.
python3 "$repo_root/scripts/check_public.py" --commit-message "$msg_file"

# Git's own comment lines, and everything below the `--verbose` scissors, are not
# part of the message. Strip both, then drop leading blanks so `head -n1` is the
# real subject even when the editor opened on an empty first line.
clean="$(sed '/^# -\+ >8 -\+$/,$d' "$msg_file" | grep -v '^#')"
body_start="$(printf '%s\n' "$clean" | sed -n '/./,$p')"
subject="$(printf '%s\n' "$body_start" | head -n1)"
second="$(printf '%s\n' "$body_start" | sed -n '2p')"

# Messages git or a tool composes, not a human: nothing to enforce.
case "$subject" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
  '') echo "commit-msg: empty commit message." >&2; exit 1 ;;
esac

# Same list as the Zed `commit_message_instructions` and the CLAUDE.md section, so
# the thing that generates and the thing that judges cannot disagree.
types='feat|fix|perf|refactor|docs|test|build|ci|chore|revert'

# Scopes are derived, not hardcoded: every tracked top-level directory is a valid
# scope, so adding a workspace member needs no edit here. The extras are the
# cross-cutting areas that are real but own no directory.
#
# Read in a loop rather than with `mapfile`, which is bash 4.0+: /bin/bash on macOS
# is 3.2, where the builtin does not exist and this hook died on an unbound array
# before it judged a single subject. `${dirs[@]+...}` for the same era — 3.2 counts
# expanding an empty array as unbound under `set -u`, which is the first-commit case.
dirs=()
while IFS= read -r dir; do
  [ -n "$dir" ] && dirs+=("$dir")
done < <(git ls-tree -d --name-only HEAD 2>/dev/null | grep -v '^\.')
scopes=(${dirs[@]+"${dirs[@]}"} deps release ci lint hooks)

fail() {
  echo "commit-msg: $1" >&2
  echo >&2
  echo "  subject: $subject" >&2
  echo >&2
  echo "Conventional Commits: <type>(<scope>): <lowercase imperative description>" >&2
  echo "  types:  ${types//|/, }" >&2
  echo "  scopes: ${scopes[*]}  (optional — omit for repo-wide changes)" >&2
  echo "  feat/fix/perf/refactor release a version; docs/test/build/ci/chore do not." >&2
  echo >&2
  echo "To commit anyway: git commit --no-verify" >&2
  exit 1
}

[[ ${#subject} -le 72 ]] || fail "subject is ${#subject} characters, over the 72 limit."

if [[ ! $subject =~ ^($types)(\(([a-z0-9][a-z0-9._-]*)\))?(!)?:\ (.+)$ ]]; then
  fail "subject is not a Conventional Commit."
fi
scope="${BASH_REMATCH[3]}"
description="${BASH_REMATCH[5]}"

# Skipped when HEAD does not exist yet (the very first commit): there is no tree to
# derive scopes from, and rejecting every scope would be the wrong answer.
if [[ -n $scope && ${#dirs[@]} -gt 0 ]]; then
  found=""
  for s in "${scopes[@]}"; do [[ $s == "$scope" ]] && found=1 && break; done
  [[ -n $found ]] || fail "'$scope' is not a known scope."
fi

# Uppercase first word is the tell that the built-in "capitalize the subject line"
# rule won over the convention — the single most common way a generated message
# comes back wrong.
[[ $description =~ ^[A-Z] ]] && fail "the description must not start with a capital."
[[ $description == *. ]] && fail "the description must not end with a period."

# A body that starts on line 2 is invisible to `git log --oneline` and to
# release-please's changelog, which reads the subject alone.
[[ -z $second ]] || fail "leave a blank line between the subject and the body."

exit 0
